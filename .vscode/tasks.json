{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "宠物医院 API",
      "type": "process",
      "command": "${workspaceFolder}/pethospital.exe",
      "args": [
        "-addr",
        "127.0.0.1:8080"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "宠物医院 MCP HTTP",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "pet_hospital_mcp.server",
        "--transport",
        "streamable-http",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/pet-hospital-mcp",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/pet-hospital-mcp/src",
          "PET_HOSPITAL_API_BASE_URL": "http://127.0.0.1:8080"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "启动宠物医院服务",
      "dependsOn": [
        "宠物医院 API",
        "宠物医院 MCP HTTP"
      ],
      "dependsOrder": "parallel"
    }
  ]
}